 "meta": [
  {
   "label": "03_hourly_heatmap.sql",
   "value": "-- 요일 × 시간대(UTC) 판매 건수 (최근 28일)\nSELECT\n    weekday_utc,                       -- 0=일 ... 6=토\n    hour_utc,                          -- 0 ~ 23\n    COUNT(*) AS sales\nFROM v_sales\nWHERE sale_date > (SELECT date(MAX(sale_date), '-28 days') FROM fact_sales)\nGROUP BY weekday_utc, hour_utc\nORDER BY weekday_utc, hour_utc;\n",
   "type": "code",
   "lang": "sql"
  },
  {
   "label": "Input",
   "value": "data/sample_salesfeed.csv → sql/schema.sql + sql/load.sql (SQLite)"
  }
 ]
